# Demo values for local work. Copy to .env and export them (the app reads real environment
# variables; it does not load .env itself), e.g.  set -a; source .env; set +a
DJANGO_SECRET_KEY=change-me-demo-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Any dj-database-url URL. Unset = SQLite file db.sqlite3 next to manage.py.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://msdat:demo-password@localhost:5432/msdat

# CORS: with nothing set every origin is allowed (the API is read-mostly, token header auth).
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com
# CORS_ALLOW_ALL_ORIGINS=false

# Celery broker (Redis). Only needed for the cache-refresh task.
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional memcached for Django's cache; unset = in-process LocMem cache.
# MEMCACHED_LOCATION=127.0.0.1:11211

# Production only (DJANGO_DEBUG=false)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=3600

# Used by the test suite when you want to run it on PostgreSQL instead of in-memory SQLite.
# TEST_DATABASE_URL=postgres://postgres:demo-password@localhost:5432/msdat
